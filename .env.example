# Template for the gitignored .env file: cp .env.example .env, then fill in real values.
# All variables are read via config/config.py (TMDB_*) or directly by the AI analysis/judge
# code (AI_*, GROQ_API_KEY). Docker compose loads .env verbatim; the K8s tmdb-secrets Secret
# is created from it; CI generates its own .env from repo secrets/variables.

# --- TMDB credentials (required) ---
TMDB_API_KEY=your_v3_api_key
TMDB_AUTH_TOKEN=your_v4_bearer_token

# --- TMDB credentials for account/list-write tests ---
TMDB_SESSION_ID=
TMDB_USER_ACCESS_TOKEN=
TMDB_REQ_TOKEN=

# --- TMDB settings (defaults shown; override only if needed) ---
# TMDB_BASE_URL=https://api.themoviedb.org
# TMDB_API_VERSION=3
# TMDB_TIMEOUT=30
# TMDB_ACCOUNT_ID=12016691
# TMDB_MOVIE_ID=346698

# --- AI failure analysis & diagnosis judging (optional) ---
# Local pytest runs can use the --failure-analysis / --judge-diagnosis flags instead;
# Docker/K8s/CI runs have no CLI flags and rely on these variables.
AI_ANALYSIS_ENABLED=false
AI_JUDGE_ENABLED=false
GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
# AI_JUDGE_MODEL=openai/gpt-oss-120b
# Agentic refine loop (only runs when judging is enabled): the judge critiques each
# diagnosis and the analyzer improves it until the judge passes and confidence clears
# the target, capped at AI_REFINE_MAX_ITERS passes.
# AI_REFINE_MAX_ITERS=2
# AI_REFINE_CONFIDENCE_TARGET=90